# ==========================================
# Production Environment Variables Template
# Indian Automated Stock Trading Platform
# ==========================================

# Database Settings
POSTGRES_DB=trading_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_production_password_2026

# JWT Security (Must be >= 256 bits / 32 characters)
JWT_SECRET=production_strong_jwt_signing_secret_key_change_me_immediately_2026

# Master Encryption Key for Broker API Credentials (AES-256-GCM hex key)
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Broker Live Credentials (Optional - configure per account in UI or here)
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# Email SMTP Notification Configuration
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_SENDER=no-reply@algo-platform.in

# WhatsApp Cloud API (Meta Developer)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
